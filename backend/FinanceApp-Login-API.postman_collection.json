{
  "info": {
    "name": "FinanceApp - Login with CAPTCHA",
    "description": "API collection để test tính năng đăng nhập với CAPTCHA",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "refresh_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"newuser@example.com\",\n  \"password\": \"Test123!\",\n  \"confirmPassword\": \"Test123!\",\n  \"fullName\": \"New User\",\n  \"userName\": \"newuser\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "register"]
            },
            "description": "Đăng ký tài khoản mới. Email xác thực sẽ được gửi."
          },
          "response": []
        },
        {
          "name": "Login (Successful)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Lưu tokens vào environment variables",
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set(\"access_token\", jsonData.accessToken);",
                  "    pm.collectionVariables.set(\"refresh_token\", jsonData.refreshToken);",
                  "    console.log(\"Access Token saved:\", jsonData.accessToken);",
                  "    console.log(\"Refresh Token saved:\", jsonData.refreshToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"Test123!\",\n  \"captchaToken\": \"MOCK_CAPTCHA_TOKEN_FOR_TESTING\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Đăng nhập với CAPTCHA token. \n\n**NOTE**: Để test thực tế, bạn cần:\n1. Lấy CAPTCHA token từ frontend\n2. Hoặc tạm thời disable CAPTCHA verification trong CaptchaServiceImpl"
          },
          "response": []
        },
        {
          "name": "Login (Wrong Password)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"WrongPassword123!\",\n  \"captchaToken\": \"MOCK_CAPTCHA_TOKEN_FOR_TESTING\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Test với password sai. Expect: 401 Unauthorized"
          },
          "response": []
        },
        {
          "name": "Login (Inactive Account)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"inactive@example.com\",\n  \"password\": \"Test123!\",\n  \"captchaToken\": \"MOCK_CAPTCHA_TOKEN_FOR_TESTING\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Test với tài khoản chưa được kích hoạt. Expect: 400 Bad Request"
          },
          "response": []
        },
        {
          "name": "Login (Invalid CAPTCHA)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"Test123!\",\n  \"captchaToken\": \"INVALID_TOKEN\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Test với CAPTCHA token không hợp lệ. Expect: 400 Bad Request"
          },
          "response": []
        },
        {
          "name": "Login (No CAPTCHA)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"Test123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Test không có CAPTCHA token. Expect: 400 Bad Request với validation error"
          },
          "response": []
        },
        {
          "name": "Verify Account",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/auth/verify-account?token=YOUR_VERIFICATION_TOKEN",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "verify-account"],
              "query": [
                {
                  "key": "token",
                  "value": "YOUR_VERIFICATION_TOKEN",
                  "description": "Token nhận được từ email"
                }
              ]
            },
            "description": "Xác thực tài khoản sau khi đăng ký"
          },
          "response": []
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/forgot-password",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "forgot-password"]
            },
            "description": "Gửi email reset password"
          },
          "response": []
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"RESET_TOKEN_FROM_EMAIL\",\n  \"newPassword\": \"NewPass123!\",\n  \"confirmPassword\": \"NewPass123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/reset-password",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "reset-password"]
            },
            "description": "Đặt lại mật khẩu với token từ email"
          },
          "response": []
        }
      ],
      "description": "Các endpoint xác thực"
    },
    {
      "name": "Protected Endpoints (Example)",
      "item": [
        {
          "name": "Get User Profile (Protected)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/user/profile",
              "host": ["{{base_url}}"],
              "path": ["api", "user", "profile"]
            },
            "description": "Ví dụ endpoint được bảo vệ. Sẽ implement sau khi có JWT filter."
          },
          "response": []
        }
      ],
      "description": "Ví dụ các endpoint cần authentication (sẽ implement sau)"
    }
  ]
}

